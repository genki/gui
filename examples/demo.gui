app: Demo

drill:
  Home:
    - Products:
        - ProductDetail:
            - ProductReviews
            - ProductRelated
    - AdminRoot:
        - AdminUsers

inherit:
  RootLayout:
    - Home
    - Products
    - ProductDetail
    - ProductReviews
    - ProductRelated
    - AdminShell:
        - AdminRoot:
            - AdminUsers

nav:
  GlobalNav:
    - Home
    - Products
    - AdminRoot

  ProductTabs:
    - ProductDetail
    - ProductReviews
    - ProductRelated

pages:
  Home:
    title: Top
    path: /
    nav: [GlobalNav]

  Products:
    title: Products
    path: /products
    nav: [GlobalNav]

  ProductDetail:
    title: Product Detail
    path: /products/:id
    nav: [GlobalNav, ProductTabs]

  ProductReviews:
    title: Product Reviews
    path: /products/:id/reviews
    nav: [GlobalNav, ProductTabs]

  ProductRelated:
    title: Related Products
    path: /products/:id/related
    nav: [GlobalNav, ProductTabs]

  AdminRoot:
    title: Admin
    path: /admin
    nav: [GlobalNav]

  AdminUsers:
    title: User Admin
    path: /admin/users
    nav: [GlobalNav]

groups:
  - id: CommerceFlow
    members: [Products, ProductDetail, ProductReviews, ProductRelated]
  - id: AdminFlow
    members: [AdminRoot, AdminUsers]
