app: Demo

nav:
  GlobalNav:
    - Home
    - Products
    - AdminRoot

  ProductTabs:
    - ProductDetail
    - ProductReviews
    - ProductRelated

inherit:
  RootLayout:
    - Home
    - Products
    - ProductDetail
    - ProductReviews
    - ProductRelated
    - AdminRoot:
        - AdminUsers

drill:
  Home:
    - Products:
        - ProductDetail:
            - ProductReviews
            - ProductRelated
    - AdminRoot:
        - AdminUsers

pages:
  - id: Home
    title: Top
    path: /
    traits: [GlobalNav]

  - id: Products
    title: Products
    path: /products
    traits: [GlobalNav]

  - id: ProductDetail
    title: Product Detail
    path: /products/:id
    traits: [GlobalNav, ProductTabs]

  - id: ProductReviews
    title: Product Reviews
    path: /products/:id/reviews
    traits: [GlobalNav, ProductTabs]

  - id: ProductRelated
    title: Related Products
    path: /products/:id/related
    traits: [GlobalNav, ProductTabs]

  - id: AdminRoot
    title: Admin
    path: /admin
    traits: [GlobalNav]

  - id: AdminUsers
    title: User Admin
    path: /admin/users
    traits: [GlobalNav]

groups:
  - id: CommerceFlow
    members: [Products, ProductDetail, ProductReviews, ProductRelated]
  - id: AdminFlow
    members: [AdminRoot, AdminUsers]
